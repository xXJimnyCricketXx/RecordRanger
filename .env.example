MONGODB_URL=mongodb://mongodb:27017/recordranger

PASSJWT=SomeComplexPassword
SESSION_SECRET=AnotherComplexSecret

# HTTPS Configuration
PROD=false # Change to true ONLY if you use HTTPS. If not, leave as false.

# RecordRanger
VINYL_PORT=3099

# Base URL for serving on a sub-path, leave empty to serve from root (default)
BASE_URL=

# Discogs - optional, app works without token
# With token: 60 req/min + condition-based price suggestions
# Without token: basic functionality works (search, metadata, market prices)
# Get your personal token at: https://www.discogs.com/settings/developers
DISCOGS_TOKEN=
