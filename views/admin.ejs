    <!-- Musik-Sammler Modal -->
    <div id="importMusikSammlerModal"
        class="fixed inset-0 z-50 hidden bg-black/80 backdrop-blur-md flex items-center justify-center p-6">
        <div class="absolute inset-0" onclick="toggleModal('importMusikSammlerModal')"></div>
        <div
            class="card-theme relative w-full max-w-md rounded-[2.5rem] p-8 md:p-10 shadow-2xl transition-all animate-scale-in overflow-y-auto max-h-[90vh]">
            <button onclick="toggleModal('importMusikSammlerModal')"
                class="absolute top-6 right-6 opacity-40 hover:opacity-100 hover:rotate-90 transition-all">
                <i class="fa-solid fa-xmark text-2xl"></i>
            </button>

            <h3 class="text-2xl font-black mb-1 flex items-center gap-3">
                <i class="fa-solid fa-music text-[#004A8F] dark:text-blue-500"></i>
                <%= t('admin.musiksammler.title') %>
            </h3>
            <p class="text-sm opacity-60 mb-6">
                <%= t('admin.musiksammler.modal_subtitle') %>
            </p>

            <!-- Mini tutorial -->
            <div class="bg-black/5 dark:bg-white/5 rounded-2xl p-4 mb-6 space-y-3">
                <p class="text-[10px] font-black uppercase tracking-widest opacity-50">
                    <%= t('admin.musiksammler.how_to') %>
                </p>
                <div class="flex items-start gap-3 text-sm opacity-70">
                    <span
                        class="bg-primary-theme text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5">1</span>
                    <span>
                        <%= t('admin.musiksammler.step1') %>
                    </span>
