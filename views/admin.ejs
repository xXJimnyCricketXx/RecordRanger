                <select id="musikSammlerImportType"
                    class="bg-black/5 dark:bg-white/5 border border-transparent text-gray-900 dark:text-white text-sm rounded-lg focus:ring-primary-theme focus:border-primary-theme block w-full p-3 transition-colors outline-none cursor-pointer">
                    <option class="bg-white dark:bg-[#1a1a1a]" value="collection" selected>
                        <%= t('admin.import.collection') %>
                    </option>
                    <option class="bg-white dark:bg-[#1a1a1a]" value="wishlist">
                        <%= t('admin.import.wantlist') %>
                    </option>
                </select>
            </div>

            <!-- File Upload -->
            <div class="mb-6">
                <label class="block text-[10px] font-black uppercase tracking-widest opacity-50 mb-2">
                    <%= t('admin.musiksammler.drop_hint') %>
                </label>
                <label class="w-full flex flex-col items-center justify-center gap-2 py-6 border-2 border-dashed border-neutral-300 dark:border-neutral-700 rounded-2xl text-neutral-500 hover:border-primary-theme hover:text-primary-theme hover:bg-primary-theme/5 transition-all cursor-pointer">
                    <i class="fa-solid fa-file-csv text-2xl"></i>
                    <span id="musikSammlerFileName" class="text-xs font-bold text-center px-4">
                        Sélectionner un fichier .csv
                    </span>
                    <input type="file" id="musikSammlerInput" class="hidden" accept=".csv">
                </label>
