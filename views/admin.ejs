                <div class="flex items-start gap-3 text-sm opacity-70">
                    <span
                        class="bg-primary-theme text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5">2</span>
                    <span>
                        <%= t('admin.musiksammler.step2') %>
                    </span>
                </div>
                <div class="flex items-start gap-3 text-sm opacity-70">
                    <span
                        class="bg-primary-theme text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5">3</span>
                    <span>
                        <%= t('admin.musiksammler.step3') %>
                    </span>
                </div>
                <div class="flex items-start gap-3 text-sm opacity-70">
                    <span
                        class="bg-primary-theme text-white text-[10px] font-black w-5 h-5 rounded-full flex items-center justify-center shrink-0 mt-0.5">4</span>
                    <span>
                        <%= t('admin.musiksammler.step4') %>
